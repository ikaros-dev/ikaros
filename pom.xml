<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>run.ikaros</groupId>
    <artifactId>ikaros</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Ikaros</name>
    <description>自托管的个人数字内容平台</description>

    <modules>
        <module>common-api</module>
        <module>common</module>
        <module>sync-api</module>
        <module>resource-api</module>
        <module>resource</module>
        <module>integration-api</module>
        <module>integration</module>
        <module>operations-api</module>
        <module>operations</module>
        <module>authorization-api</module>
        <module>authentication-api</module>
        <module>authentication</module>
        <module>authorization</module>
        <module>storage-api</module>
        <module>media-api</module>
        <module>media</module>
        <module>storage</module>
        <module>drive</module>
        <module>sync</module>
        <module>backup</module>
        <module>password-manager</module>
        <module>plugin</module>
        <module>reading</module>
        <module>search</module>
        <module>sharing</module>
        <module>document</module>
        <module>game</module>
        <module>music</module>
        <module>photo</module>
        <module>private-notes</module>
        <module>finance</module>
        <module>ingestion</module>
        <module>planning</module>
        <module>application</module>
    </modules>

    <properties>
        <revision>2.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <springdoc.version>3.0.3</springdoc.version>
        <r2dbc-migrate.version>4.0.1</r2dbc-migrate.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <java-jwt.version>4.5.0</java-jwt.version>
        <aws-sdk.version>2.31.63</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
