<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="插件加载流程图">
    <mxGraphModel>
      <root>
        <mxCell id="p2_0" />
        <mxCell id="p2_1" parent="p2_0" />

        <!-- ========== 标题 ========== -->
        <mxCell id="p2_title" value="Ikaros 插件加载完整生命周期" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="p2_1">
          <mxGeometry x="250" y="10" width="500" height="36" as="geometry"/>
        </mxCell>

        <!-- ========== 步骤节点 (从 y=60 开始) ========== -->

        <!-- 步骤 1：应用启动 -->
        <mxCell id="p2_s1" value="① 应用启动&#xa;ApplicationReadyEvent" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2_1">
